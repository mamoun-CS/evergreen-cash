# EverGreen CASH - Environment Variables

# Neon Postgres / Vercel Postgres connection URL
# Add the same values to Vercel project → Settings → Environment Variables
POSTGRES_URL=""
DATABASE_URL=""
# Required to authorize /api/sync requests. Configure the same value on each device.
SYNC_API_KEY=
# Set to false only for local Postgres without TLS; defaults to TLS enabled.
POSTGRES_SSL=true
